<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>grupo5</groupId>
        <artifactId>donatrack</artifactId>
        <version>1.0</version>
    </parent>

    <!-- Entrada única del cliente a los servicios (ADR-E6-02, etapa 1: rutas y traceId, sin JWT). -->
    <artifactId>api-gateway</artifactId>
    <packaging>jar</packaging>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway-server-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Filtro de traceId, adopción del X-Trace-Id en OpenTelemetry, logs NDJSON y error unificado. -->
        <dependency>
            <groupId>grupo5</groupId>
            <artifactId>common-lib</artifactId>
            <version>1.0</version>
        </dependency>
        <!-- Resource server (ADR-E6-02, etapa 2): valida el JWT de Keycloak antes de enrutar. Apagado
             por defecto (donatrack.seguridad.habilitada=false). Sin versión: la administra el BOM. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
        </dependency>
        <!-- Rate limiting (E7, requerimiento 3; ADR 20261115): token bucket, una cubeta por usuario o
             por IP, guardada en Redis (decisión Q11) con Lettuce. Versión en el pom raíz; la de
             lettuce-core la fija el BOM de Spring Boot. -->
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j_jdk17-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j_jdk17-lettuce</artifactId>
        </dependency>
        <!-- bucket4j_jdk17-lettuce la declara provided: hay que traerla. -->
        <dependency>
            <groupId>io.lettuce</groupId>
            <artifactId>lettuce-core</artifactId>
        </dependency>
        <!-- Redis real para CubetasEnRedisContraRedisTest; sin Docker el test se saltea
             (@DisabledIfDockerUnavailable, [DEFERRED_NO_DOCKER]). -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
