# Credenciales de docker compose (local y preprod): Postgres, Keycloak, MongoDB, RabbitMQ y MinIO.
# Uso: cp .env.example .env  — o bien scripts/generar-env-db.sh para valores aleatorios.
# .env está en .gitignore: no versionar contraseñas reales.
# Cambiar una contraseña con el volumen ya creado exige `docker compose down -v`
# (el init-db de Postgres solo corre en el primer arranque; MinIO guarda sus credenciales en su volumen).
POSTGRES_PASSWORD=cambiar-admin-local
NOTIFICACIONES_DB_PASSWORD=cambiar-notificaciones-local
INCENTIVOS_DB_PASSWORD=cambiar-incentivos-local
LOGISTICA_DB_PASSWORD=cambiar-logistica-local
DONACIONES_DB_PASSWORD=cambiar-donaciones-local
# RabbitMQ: el usuario es fijo (donatrack); los 4 servicios leen RABBITMQ_PASS.
RABBITMQ_PASS=cambiar-rabbitmq-local
# MinIO: usuario y contraseña raíz (solo los usa minio-init para crear los usuarios por servicio).
# Cada servicio tiene su usuario fijo (incentivos-service, donaciones-service) con acceso solo a sus
# buckets; acá va su contraseña. MinIO exige al menos 3 caracteres de usuario y 8 de contraseña.
MINIO_ROOT_USER=donatrack-minio
MINIO_ROOT_PASSWORD=cambiar-minio-local
INCENTIVOS_MINIO_PASSWORD=cambiar-incentivos-minio-local
DONACIONES_MINIO_PASSWORD=cambiar-donaciones-minio-local
# MongoDB (logistica-service): usuario root y usuario de la aplicación (readWrite sobre logistica).
# Van dentro de la URI de conexión: usar solo letras, números y guiones.
MONGO_ROOT_USER=donatrack-mongo
MONGO_ROOT_PASSWORD=cambiar-mongo-local
LOGISTICA_MONGO_USER=logistica_user
LOGISTICA_MONGO_PASSWORD=cambiar-logistica-mongo-local
# Keycloak (auth-service, IdP). Base propia `keycloak` con el rol keycloak_user: cambiar su contraseña
# exige `docker compose down -v`, igual que el resto de Postgres.
KEYCLOAK_DB_PASSWORD=cambiar-keycloak-local
# Admin de la consola de Keycloak (http://localhost:8180). NO es el ADMIN de DonaTrack. Keycloak lo crea
# solo con la base vacía: para cambiarlo también hace falta `docker compose down -v`.
KC_BOOTSTRAP_ADMIN_USERNAME=kc-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=cambiar-keycloak-admin-local
# URL pública del issuer: la misma que ven el navegador y los servicios (el claim iss sale de acá).
KC_HOSTNAME=http://localhost:8180
KC_HTTP_ENABLED=true
KC_HEALTH_ENABLED=true
# Cliente liviano como cliente OAuth2 del realm donatrack (SPEC-06 A1-02). El realm los lee al importarse
# (${CLIENTE_LIVIANO_SECRET} y ${CLIENTE_LIVIANO_BASE_URL} en auth-service/realm/donatrack-realm.json):
# el secreto es el que usará el cliente liviano (B1-01) y la URL base es donde corre el sitio, de donde
# salen los redirect y post-logout. Solo se leen con la base vacía: cambiarlos exige `docker compose down -v`.
# [INFERRED] el puerto 8090 es provisorio: poné el que use el cliente liviano.
CLIENTE_LIVIANO_SECRET=cambiar-cliente-liviano-secreto-local
CLIENTE_LIVIANO_BASE_URL=http://localhost:8090
# ADMIN inicial de DonaTrack (rol ADMIN), que el realm importa (SPEC-06 A1-03). NO es el admin de la consola
# de Keycloak (KC_BOOTSTRAP_ADMIN_*). La clave tiene que cumplir la política del realm (10 a 128 caracteres y
# distinta del email): si no, Keycloak no arranca. Solo se lee con la base vacía (cambiarla exige `down -v`).
AUTH_ADMIN_EMAIL=admin@donatrack.local
AUTH_ADMIN_PASSWORD=cambiar-admin-donatrack-local