<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Hereda del pom raíz (Spotless, JaCoCo, BOMs) pero NO está en sus <modules>: el `mvn` de los
         demás servicios no lo compila. Se corre aparte (SPEC-06 A1-02):
         mvn -f auth-service/pom.xml -Pcontrato-auth verify
         Sumarlo al build general queda para E2-12 (Keycloak en preprod y CI). -->
    <parent>
        <groupId>grupo5</groupId>
        <artifactId>donatrack</artifactId>
        <version>1.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>auth-service</artifactId>
    <name>auth-service</name>
    <description>Contrato del realm de Keycloak (SPEC-06): levanta la imagen del Dockerfile y verifica los tokens</description>

    <dependencies>
        <!-- Solo el núcleo de Testcontainers (GenericContainer, ImageFromDockerfile): este test no usa la
             extensión de JUnit. Sin versión: la administra el BOM de Spring Boot (2.0.5). Declarar
             `junit-jupiter` mezclaba su 1.20.4 (del testcontainers-bom del pom raíz) con el núcleo 2.0.5.
             Jackson, igual que integration-tests. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!-- Los *IT levantan Keycloak en Docker (construyen la imagen y esperan el arranque):
             no corren en `mvn test` ni en el build por defecto. -->
        <profile>
            <id>contrato-auth</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>3.2.5</version>
                        <configuration>
                            <includes>
                                <include>**/*IT.java</include>
                            </includes>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
