{
  "realm": "donatrack",
  "enabled": true,
  "displayName": "DonaTrack",
  "loginTheme": "donatrack",
  "internationalizationEnabled": true,
  "supportedLocales": ["es"],
  "defaultLocale": "es",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 28800,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "passwordPolicy": "length(10) and maxLength(128) and notEmail",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "maxDeltaTimeSeconds": 900,
  "waitIncrementSeconds": 900,
  "maxFailureWaitSeconds": 900,
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": ["{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false,\"required\":{\"roles\":[\"user\"]}},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}]}"]
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-donatrack",
    "description": "Roles que reciben las cuentas nuevas",
    "composite": true,
    "clientRole": false
  },
  "roles": {
    "realm": [
      { "name": "DONANTE", "description": "Persona o empresa que dona" },
      { "name": "ENTIDAD", "description": "Entidad receptora de donaciones" },
      { "name": "ADMIN", "description": "Administración de DonaTrack" },
      {
        "name": "default-roles-donatrack",
        "description": "Roles que reciben las cuentas nuevas: el autorregistro da DONANTE",
        "composite": true,
        "composites": { "realm": ["offline_access", "uma_authorization", "DONANTE"] }
      },
      { "name": "offline_access", "description": "Permite pedir tokens offline" },
      { "name": "uma_authorization", "description": "Autorización UMA" }
    ]
  },
  "users": [
    {
      "username": "${AUTH_ADMIN_EMAIL}",
      "email": "${AUTH_ADMIN_EMAIL}",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "${AUTH_ADMIN_PASSWORD}", "temporary": false }
      ],
      "realmRoles": ["ADMIN"]
    }
  ],
  "scopeMappings": [
    { "client": "cliente-liviano", "roles": ["DONANTE", "ENTIDAD", "ADMIN"] }
  ],
  "clients": [
    {
      "clientId": "cliente-liviano",
      "name": "Cliente liviano",
      "description": "Sitio web de DonaTrack: cliente OIDC confidencial con authorization code",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${CLIENTE_LIVIANO_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": ["${CLIENTE_LIVIANO_BASE_URL}/login/oauth2/code/keycloak"],
      "webOrigins": [],
      "attributes": {
        "post.logout.redirect.uris": "${CLIENTE_LIVIANO_BASE_URL}/"
      },
      "defaultClientScopes": ["basic"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "lightweight.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "audiencia-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "donatrack-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "lightweight.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ]
}
