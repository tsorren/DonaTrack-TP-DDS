{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://donatrack.utn.edu.ar/schemas/entrega-response.schema.json",
  "title": "EntregaResponseDTO",
  "description": "Representación de una entrega en el microservicio de logística",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "idRuta": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "idDonacion": {
      "type": "string",
      "format": "uuid"
    },
    "idBeneficiaria": {
      "type": "string",
      "format": "uuid"
    },
    "destino": {
      "type": "object"
    },
    "estadoActual": {
      "type": "string",
      "enum": [
        "PENDIENTE",
        "EN_TRASLADO",
        "ENTREGADA",
        "NO_RECIBIDA",
        "REVISION"
      ]
    },
    "horaSalida": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "horaArribo": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "fotoRecepcionUrl": {
      "type": ["string", "null"]
    },
    "volumenTotalM3": {
      "type": "number"
    },
    "pesoTotalKG": {
      "type": "number"
    },
    "historialEstado": {
      "type": "array"
    },
    "numeroRemito": {
      "type": ["string", "null"],
      "description": "Remito cargado al confirmar (HB-17); nulo si no se cargó."
    },
    "reporte": {
      "type": ["object", "null"],
      "description": "Problema contado al confirmar (HB-17); nulo si llegó bien.",
      "properties": {
        "motivo": { "type": "string", "enum": ["INCOMPLETA", "DANADA", "OTRO"] },
        "detalle": { "type": ["string", "null"], "maxLength": 500, "description": "Obligatorio con OTRO." },
        "cantidadRecibida": { "type": ["number", "null"], "exclusiveMinimum": 0, "description": "En la unidad de la donación; obligatoria con INCOMPLETA." }
      },
      "required": ["motivo"],
      "additionalProperties": false
    }
  },
  "required": ["id", "idDonacion", "idBeneficiaria", "estadoActual"],
  "additionalProperties": true
}
