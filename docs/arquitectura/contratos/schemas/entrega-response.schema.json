{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://donatrack.utn.edu.ar/schemas/entrega-response.schema.json",
  "title": "EntregaResponseDTO",
  "description": "Representación de una entrega en el microservicio de logística",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "idRuta": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "idDonacion": {
      "type": "string",
      "format": "uuid"
    },
    "idBeneficiaria": {
      "type": "string",
      "format": "uuid"
    },
    "destino": {
      "type": "object"
    },
    "estadoActual": {
      "type": "string",
      "enum": [
        "PENDIENTE",
        "EN_TRASLADO",
        "ENTREGADA",
        "NO_RECIBIDA",
        "REVISION"
      ]
    },
    "horaSalida": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "horaArribo": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "fotoRecepcionUrl": {
      "type": ["string", "null"]
    },
    "volumenTotalM3": {
      "type": "number"
    },
    "pesoTotalKG": {
      "type": "number"
    },
    "historialEstado": {
      "type": "array"
    }
  },
  "required": ["id", "idDonacion", "idBeneficiaria", "estadoActual"],
  "additionalProperties": true
}
