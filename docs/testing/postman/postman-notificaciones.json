        {
          "name": "8. Procesar Evento (Entrega Fallida)",
          "description": "Único tipo con 0..N notificaciones reales: genera aviso tanto al admin (idPersonaAdmin) como al donante (idPersonaDonante).",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status 202 Accepted', function() { pm.response.to.have.status(202); });"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo\": \"ENTREGA_FALLIDA\",\n  \"idPersonaDonante\": \"{{personaId}}\",\n  \"fecha\": \"{{$isoTimestamp}}\",\n  \"idPersonaBeneficiaria\": \"33333333-3333-3333-3333-333333333333\",\n  \"detalleDonacion\": \"5 paquetes de fideos\",\n  \"idPersonaAdmin\": \"44444444-4444-4444-4444-444444444444\",\n  \"motivo\": \"Nadie recibió el envío en el domicilio\",\n  \"replanificable\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/notificaciones", "host": ["{{baseUrl}}"], "path": ["notificaciones"] }
          }
        },
        {
          "name": "9. Obtener Notificaciones por Persona ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/notificaciones/persona/{{personaId}}", "host": ["{{baseUrl}}"], "path": ["notificaciones", "persona", "{{personaId}}"] }
          }
