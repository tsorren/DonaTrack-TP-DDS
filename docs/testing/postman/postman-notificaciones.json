{
  "info": {
    "_postman_id": "donatrack-notificaciones-swagger-verified-v2",
    "name": "DonaTrack - Notificaciones Service (Swagger Verified)",
    "description": "Colección verificada contra los Controllers de Swagger UI de notificaciones-service (:8081).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081" },
    { "key": "personaId", "value": "11111111-1111-1111-1111-111111111111" }
  ],
  "item": [
    {
      "name": "01. Personas Controller",
      "item": [
        {
          "name": "1. Sincronizar Réplica de Persona",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status 200 OK / 201 Created', function() { pm.expect([200, 201]).to.include(pm.response.code); });"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{personaId}}\",\n  \"denominacion\": \"Juan Perez\",\n  \"tipoPersona\": \"HUMANA\",\n  \"mediosDeContacto\": [\n    {\n      \"tipo\": \"CORREO\",\n      \"esPredeterminado\": true,\n      \"direccionCorreo\": \"juan.perez@example.com\"\n    },\n    {\n      \"tipo\": \"WHATSAPP\",\n      \"esPredeterminado\": false,\n      \"caracteristica\": \"11\",\n      \"codigoArea\": \"54\",\n      \"numero\": \"55554444\"\n    }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/notificaciones/personas", "host": ["{{baseUrl}}"], "path": ["api", "notificaciones", "personas"] }
          }
        },
        {
          "name": "2. Obtener Persona Replicada por ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/notificaciones/personas/{{personaId}}", "host": ["{{baseUrl}}"], "path": ["api", "notificaciones", "personas", "{{personaId}}"] }
          }
        },
        {
          "name": "3. Anonimizar Persona",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/notificaciones/personas/{{personaId}}", "host": ["{{baseUrl}}"], "path": ["api", "notificaciones", "personas", "{{personaId}}"] }
          }
        },
        {
          "name": "4. Sincronizar Réplica de Persona (Jurídica + Teléfono)",
          "description": "Variante no cubierta antes: tipoPersona JURIDICA y medio de contacto TELEFONO (distinto de WHATSAPP).",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"55555555-5555-5555-5555-555555555555\",\n  \"denominacion\": \"Comedor Solidario\",\n  \"tipoPersona\": \"JURIDICA\",\n  \"mediosDeContacto\": [\n    {\n      \"tipo\": \"TELEFONO\",\n      \"esPredeterminado\": true,\n      \"caracteristica\": \"11\",\n      \"codigoArea\": \"54\",\n      \"numero\": \"40001111\"\n    }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/notificaciones/personas", "host": ["{{baseUrl}}"], "path": ["api", "notificaciones", "personas"] }
          }
        }
      ]
    },
    {
      "name": "02. Notificación Controller",
      "item": [
        {
          "name": "1. Procesar Evento (Donante Registrado)",
          "description": "credencialesDeAcceso viaja como texto plano y el propio dominio (DonanteRegistrado.generarNotificaciones()) lo reenvía tal cual al donante por correo/WhatsApp — deuda de seguridad de fondo del servicio, no de este ejemplo. Considerar reemplazar por un token/link de primer acceso.",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status 202 Accepted', function() { pm.response.to.have.status(202); });"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo\": \"DONANTE_REGISTRADO\",\n  \"idPersonaDonante\": \"{{personaId}}\",\n  \"fecha\": \"{{$isoTimestamp}}\",\n  \"credencialesDeAcceso\": \"USER: juan.perez | PASS: temp1234\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/notificaciones", "host": ["{{baseUrl}}"], "path": ["notificaciones"] }
          }
        },
        {
          "name": "2. Procesar Evento (Misión Cumplida)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
