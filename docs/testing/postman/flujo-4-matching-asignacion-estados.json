    },
    {
      "name": "A. Camino feliz: EN_DEPOSITO → ... → ENTREGADA",
      "item": [
        {
          "name": "1. Cargar Donación A",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('donacionAId', json.id);",
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idDonante\": \"{{donanteId}}\",\n  \"descripcion\": \"Donación A QA\",\n  \"items\": [\n    { \"descripcionBien\": \"Articulo Inclasificable A QA\", \"cantidad\": 10, \"estadoBien\": \"NUEVO\", \"fechaVencimiento\": \"2027-12-31\", \"pesoUnitario\": 0.5, \"volumenUnitario\": 0.005 }\n  ],\n  \"nombreDeposito\": \"Depósito QA\",\n  \"direccion\": {\n    \"calle\": \"Av. Medrano\", \"altura\": 951, \"codigoPostal\": \"1179\", \"localidad\": \"CABA\", \"provincia\": \"CABA\", \"pais\": \"Argentina\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/donaciones",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "donaciones"
              ]
            },
            "description": "descripcionBien deliberadamente inventada: donaciones-service siembra en cada arranque 8 subcategorías fijas (No Perecederos, Frutas, Ropa de Invierno/Verano, Muebles...) con alias como 'arroz'/'fideos'/'ropa'. Si usás esas palabras acá, el normalizador semántico auto-acepta contra la subcategoría SEMBRADA, no contra la tuya (Setup 2.), y el matching de la carpeta 3-6 nunca encuentra nada. Por eso el ítem queda a propósito sin match (PENDIENTE_REVISION) y se reclasifica a mano en el paso 1b-1c."
          }
        },
        {
          "name": "1b. Obtener Ítems Normalizados Pendientes",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Fix: esperar que @Async ProcesadorDeDonaciones termine de normalizar el ítem",
                  "const waitMs = 2000;",
                  "const start = new Date().getTime();",
                  "let end = start;",
                  "while (end < start + waitMs) { end = new Date().getTime(); }"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "var item = json.find(function (i) { return i.descripcionBienOriginal === 'Articulo Inclasificable A QA'; });",
                  "pm.test('Encontró el ítem de la Donación A (reintentar si no)', function () { pm.expect(item).to.not.be.undefined; });",
                  "if (item) { pm.collectionVariables.set('itemNormalizadoAId', item.id); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/items-normalizados/pendientes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "items-normalizados",
                "pendientes"
              ]
            }
          }
        },
        {
          "name": "1c. Reclasificar manualmente a la subcategoría del Setup",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estadoNormalizacion\": \"ACEPTADO\",\n  \"subcategoriaId\": \"{{subcategoriaId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/items-normalizados/{{itemNormalizadoAId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "items-normalizados",
                "{{itemNormalizadoAId}}"
              ]
            },
            "description": "ACEPTADO + subcategoriaId explícito: fuerza la subcategoría de la carpeta Setup, sin depender de ningún match semántico automático."
          }
        },
        {
          "name": "2. Esperar SEGMENTADA (reintentar si aún CARGADA)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('estadoActual == SEGMENTADA (reintentar si no)', function () { pm.expect(pm.response.json().estadoActual).to.eql('SEGMENTADA'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/donaciones/{{donacionAId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "donaciones",
                "{{donacionAId}}"
              ]
            }
          }
        },
        {
          "name": "3. Crear Necesidad A",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('necesidadAId', json.id);",
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo\": \"EXTRAORDINARIA\",\n  \"idEntidad\": \"{{entidadId}}\",\n  \"idSubcategoria\": \"{{subcategoriaId}}\",\n  \"cantidadNecesitada\": 10,\n  \"descripcion\": \"Necesidad A QA matching\",\n  \"fechaInicio\": \"2026-01-01\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/necesidades",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "necesidades"
              ]
            }
          }
        },
        {
          "name": "4. Ejecutar Algoritmo de Asignación",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 Created', function () { pm.response.to.have.status(201); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/asignaciones/ejecuciones",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "asignaciones",
                "ejecuciones"
              ]
            }
          }
        },
        {
          "name": "5. Listar Propuestas (captura propuestaAId + donacionIndependienteAId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var propuestas = pm.response.json();",
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "var propuesta = propuestas.find(function (p) { return p.necesidad && p.necesidad.descripcion === 'Necesidad A QA matching'; });",
                  "pm.test('Encontró la propuesta de Necesidad A (reintentar el paso 4 si no)', function () { pm.expect(propuesta).to.not.be.undefined; });",
                  "if (propuesta) {",
                  "  pm.collectionVariables.set('propuestaAId', propuesta.id);",
                  "  var di = propuesta.fragmentaciones[0].donacionIndependiente;",
                  "  pm.collectionVariables.set('donacionIndependienteAId', di.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/asignaciones/propuestas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "asignaciones",
                "propuestas"
              ]
            }
          }
        },
        {
          "name": "6. Aprobar Propuesta A",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"APROBADA\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/asignaciones/propuestas/{{propuestaAId}}/estado",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "asignaciones",
                "propuestas",
                "{{propuestaAId}}",
                "estado"
              ]
            },
            "description": "Dispara internamente asignar(): la DonacionIndependiente pasa de EN_DEPOSITO a ASIGNACION_REALIZADA."
          }
        },
        {
          "name": "7. [Negativo] Re-aprobar la misma propuesta",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 409 (ESTADO_DONACION_TRANSICION_INVALIDA — ya no está PENDIENTE)', function () { pm.response.to.have.status(409); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"APROBADA\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/asignaciones/propuestas/{{propuestaAId}}/estado",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "asignaciones",
                "propuestas",
                "{{propuestaAId}}",
                "estado"
              ]
            }
          }
        },
        {
          "name": "8. ASIGNACION_REALIZADA → LISTA_PARA_ENTREGAR (planificarRuta)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Actor",
                "value": "TRANSPORTISTA_QA"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"LISTA_PARA_ENTREGAR\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/donaciones-independientes/{{donacionIndependienteAId}}/estado",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "donaciones-independientes",
                "{{donacionIndependienteAId}}",
                "estado"
              ]
            }
          }
        },
        {
          "name": "9. [Negativo] Repetir LISTA_PARA_ENTREGAR",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 409 (ya no está en ASIGNACION_REALIZADA)', function () { pm.response.to.have.status(409); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Actor",
                "value": "TRANSPORTISTA_QA"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"LISTA_PARA_ENTREGAR\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/donaciones-independientes/{{donacionIndependienteAId}}/estado",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "donaciones-independientes",
                "{{donacionIndependienteAId}}",
                "estado"
              ]
            }
          }
        },
        {
          "name": "10. LISTA_PARA_ENTREGAR → EN_TRASLADO (iniciarRecorrido)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
