          }
        },
        {
          "name": "5. Crear Persona Jurídica",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Fix: generar CUIT válido (8 dígitos en el medio) y documento único para el representante",
                  "const ts = Date.now().toString();",
                  "const middle8 = ts.slice(-8);",
                  "pm.collectionVariables.set('tempCuit', '30-' + middle8 + '-9');",
                  "pm.collectionVariables.set('tempRepDocumento', '1' + ts.slice(-8));"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('personaJuridicaId', json.id);",
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo\": \"JURIDICA\",\n  \"tipoDocumento\": \"CUIT\",\n  \"documento\": \"{{tempCuit}}\",\n  \"razonSocial\": \"Entidad Matching QA {{$timestamp}}\",\n  \"tipoJuridico\": \"ONG\",\n  \"rubro\": \"Comedor\",\n  \"representantes\": [\n    { \"tipo\": \"HUMANA\", \"tipoDocumento\": \"DNI\", \"documento\": \"{{tempRepDocumento}}\", \"nombre\": \"Representante\", \"apellido\": \"QA\", \"genero\": \"MUJER\", \"fechaNacimiento\": \"1980-01-01\", \"mediosDeContacto\": [] }\n  ],\n  \"mediosDeContacto\": [],\n  \"direccion\": {\n    \"calle\": \"Av. Medrano\", \"altura\": 951, \"codigoPostal\": \"1179\", \"localidad\": \"CABA\", \"provincia\": \"CABA\", \"pais\": \"Argentina\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/personas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "personas"
              ]
            }
          }
        },
        {
          "name": "6. Crear Entidad Beneficiaria",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('entidadId', json.id);",
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });"
