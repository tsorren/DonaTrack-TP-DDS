            "url": { "raw": "{{baseUrl}}/api/asignaciones/propuestas", "host": ["{{baseUrl}}"], "path": ["api", "asignaciones", "propuestas"] }
          }
        },
        {
          "name": "3. Historial de Ejecuciones",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/asignaciones/ejecuciones", "host": ["{{baseUrl}}"], "path": ["api", "asignaciones", "ejecuciones"] }
          }
        },
        {
          "name": "4. Actualizar Estado de Propuesta (Aprobar)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"APROBADA\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/asignaciones/propuestas/{{propuestaId}}/estado", "host": ["{{baseUrl}}"], "path": ["api", "asignaciones", "propuestas", "{{propuestaId}}", "estado"] }
          }
        }
      ]
    },
    {
      "name": "10. Donaciones Independientes Controller",
      "description": "Movida al final a propósito: si se ejecuta antes de la sección 09, pasar una DonacionIndependiente a VENCIDA la saca del pool que usa el algoritmo de asignación (findEnDeposito()), invalidando esa sección.",
      "item": [
        {
          "name": "1. Cambiar Estado de Donación Independiente (Vencida/Manual)",
          "description": "LIMITACIÓN CONOCIDA: {{donacionIndependienteId}} NO es lo mismo que {{donacionId}} (sección 07). Una Donacion y una DonacionIndependiente son agregados distintos con IDs distintos; la segunda se crea de forma asíncrona (SegmentacionEventListener) recién cuando sus ítems fueron normalizados/aceptados (ver sección 08). Este controller no expone ningún GET para listar/descubrir ese id — hoy solo se puede obtener consultando la base de datos o el log de eventos directamente. Completar {{donacionIndependienteId}} a mano antes de correr este request.",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Actor", "value": "Administrador" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"VENCIDA\",\n  \"justificacion\": \"Bien caducado en depósito\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/donaciones-independientes/{{donacionIndependienteId}}/estado", "host": ["{{baseUrl}}"], "path": ["donaciones-independientes", "{{donacionIndependienteId}}", "estado"] }
          }
        }
      ]
    }
  ]
